rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin email constant
    function isAdmin() {
      return request.auth.token.email == 'aaravhfs@gmail.com';
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVolunteer() {
      return exists(/databases/$(database)/documents/volunteers/$(request.auth.token.email));
    }

    // ==================== ADMIN COLLECTION ====================
    // Only admin can read/write admin collection
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // ==================== VOLUNTEERS COLLECTION ====================
    // Volunteers can read their own record, admin can manage all
    match /volunteers/{email} {
      allow read: if request.auth.token.email == email || isAdmin();
      allow write: if isAdmin();
    }

    // ==================== SETTINGS COLLECTION ====================
    // Only admin can write settings, authenticated users can read
    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==================== PARTICIPANTS COLLECTION ====================
    // Admin can read/write all, authenticated users can read
    // Volunteers can also write checkpoint data (day1/day2 checkpoint fields)
    match /participants/{participantId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow write: if isVolunteer() && (
        request.writeFields.size() <= 2 &&
        (request.writeFields.has('day1') || request.writeFields.has('day2'))
      );
    }

    // ==================== LOGS COLLECTION ====================
    // Admin can read/write all logs, authenticated users (and volunteers) can write their own logs, all can read
    match /logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isVolunteer();
      allow delete: if isAdmin();
    }

    // ==================== BACKUP COLLECTION ====================
    // Only admin can access backups
    match /backups/{backupId} {
      allow read, write, delete: if isAdmin();
    }

    // ==================== EVENT SETTINGS ====================
    // Shared event configuration - admin can write, everyone authenticated can read
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAdmin();
      
      // Event-specific sub-collections
      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow write, delete: if isAdmin();
      }
      
      match /logs/{logId} {
        allow read: if isAuthenticated();
        allow write, delete: if isAdmin();
      }
    }

    // ==================== DEFAULT DENY ====================
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
